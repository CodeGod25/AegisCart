PORT=4000

# Razorpay test-mode (optional — without these, checkout runs in simulated mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE=https://api.razorpay.com/v1

SQLITE_DB_PATH=data/aegiscart.db

# Secret for signing offers + spend mandates (change in production)
AEGIS_SIGNING_SECRET=dev-aegis-signing-secret-change-me

# LLM adapter for the conversational + buyer agents.
# LLM_PROVIDER=mock  -> deterministic, no key, fully offline (safe demo default)
# LLM_PROVIDER=openai -> OpenAI-compatible chat completions (set LLM_API_KEY, optional LLM_BASE_URL)
# LLM_PROVIDER=anthropic -> Anthropic messages API (set LLM_API_KEY)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT_MS=15000

# Feature Flags (prefix with FEATURE_)
# Set to 'true' to enable a feature
# FEATURE_ENABLE_NEW_DASHBOARD=false
# FEATURE_ENABLE_EXPERIMENTAL_ENDPOINT=false
# FEATURE_ENABLE_AGENT_UI_ENHANCEMENTS=false
