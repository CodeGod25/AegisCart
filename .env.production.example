# Production environment - COPY THIS TO .env.production AND FILL IN THE SECRETS
# NEVER COMMIT .env.production TO VERSION CONTROL

PORT=4000

# Razorpay live mode keys (for production) or test mode if you want to test with real Razorpay in test mode
RAZORPAY_KEY_ID=your_production_key_id_here
RAZORPAY_KEY_SECRET=your_production_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_production_webhook_secret_here
RAZORPAY_API_BASE=https://api.razorpay.com/v1

SQLITE_DB_PATH=data/aegiscart.db

# Secret for signing offers + spend mandates (MUST be changed to a strong secret in production)
AEGIS_SIGNING_SECRET=your_production_signing_secret_here_change_me_to_a_long_random_string

# LLM adapter for production - you likely want to use a real LLM provider
LLM_PROVIDER=openai # or anthropic
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini # or your preferred model
LLM_BASE_URL= # optional, if using a custom endpoint or Azure/OpenAI compatible
LLM_TIMEOUT_MS=15000